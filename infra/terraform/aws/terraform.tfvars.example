# IMPORTANT:
# Set this to the actual AWS region shown for your Databricks workspace
# in the Databricks Account Console.
aws_region = "ap-southeast-2"

environment = "dev"

# Initial bootstrap only.
#
# Databricks generates the real value after the storage credential
# has been created.
databricks_storage_credential_external_id = "0000"

# Initial bootstrap must be false.
#
# After the storage credential is created, change this to true and
# replace the external ID above with the Databricks-generated value.
enable_databricks_role_self_assume = false

additional_tags = {
  Portfolio = "Enterprise Payments Intelligence Platform"
}