# ===================================================================
# Enterprise Payments Intelligence Platform
# Example Terraform variables
#
# DO NOT place secrets or real sensitive credentials in this file.
# ===================================================================


# -------------------------------------------------------------------
# AWS
# -------------------------------------------------------------------

# Region containing the Databricks workspace and EPIP AWS resources.
aws_region = "ap-southeast-2"

environment = "dev"


# -------------------------------------------------------------------
# Unity Catalog -> S3 storage credential
# -------------------------------------------------------------------

# Initial bootstrap only.
#
# Databricks generates the real External ID after the storage
# credential has been created.
databricks_storage_credential_external_id = "0000"


# Initial bootstrap:
#
#   false
#
# After Databricks generates the storage-credential External ID:
#
#   true
enable_databricks_role_self_assume = false


# -------------------------------------------------------------------
# Standard resource tags
# -------------------------------------------------------------------

additional_tags = {
  Portfolio = "Enterprise Payments Intelligence Platform"
}


# ===================================================================
# OPTIONAL AMAZON MSK STREAMING STACK
# ===================================================================
#
# Cost-safe portfolio default:
#
#   false
#
# Change to true only when the streaming demonstration is required.
# ===================================================================

enable_msk = false


# -------------------------------------------------------------------
# MSK networking
# -------------------------------------------------------------------

msk_vpc_cidr = "10.40.0.0/16"


msk_public_subnet_cidrs = [
  "10.40.10.0/24",
  "10.40.20.0/24",
]


# Secure default.
#
# Leave empty while MSK is disabled.
#
# Before public MSK connectivity is enabled, add only the required
# developer and Databricks outbound CIDRs.
#
# Example:
#
# msk_public_ingress_cidrs = [
#   "203.0.113.10/32",
# ]
#
msk_public_ingress_cidrs = []


# -------------------------------------------------------------------
# MSK Provisioned cluster
# -------------------------------------------------------------------

msk_kafka_version          = "3.9.x"
msk_broker_instance_type   = "kafka.t3.small"
msk_broker_volume_size_gib = 10


# MUST remain false during initial cluster provisioning.
#
# Enable only after the cluster becomes ACTIVE.
enable_msk_public_access = false


# Kafka topic consumed by Databricks.
msk_topic_name = "payments.events.v1"


# -------------------------------------------------------------------
# Databricks -> MSK service credential
# -------------------------------------------------------------------

# Initial bootstrap only.
#
# Replace with the Databricks-generated External ID once the
# payments_msk_dev service credential is created.
databricks_msk_service_credential_external_id = "0000"


# Initial MSK IAM-role creation must use false.
#
# Change to true after the Databricks service credential exists
# and the correct External ID has been configured.
enable_databricks_msk_role_self_assume = false