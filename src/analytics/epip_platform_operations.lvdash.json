{
  "datasets": [
    {
      "displayName": "Platform Operations Summary",
      "name": "platform_summary",
      "queryLines": [
        "SELECT *\n",
        "FROM platform_operations_summary\n"
      ]
    },
    {
      "displayName": "Pipeline Status Counts",
      "name": "pipeline_status_counts",
      "queryLines": [
        "SELECT operational_status, COUNT(*) AS pipeline_count\n",
        "FROM pipeline_operational_health\n",
        "GROUP BY operational_status\n",
        "ORDER BY operational_status\n"
      ]
    },
    {
      "displayName": "Daily Job Health",
      "name": "job_daily_health",
      "queryLines": [
        "SELECT *\n",
        "FROM job_daily_health\n",
        "ORDER BY run_date\n"
      ]
    },
    {
      "displayName": "Current DQ Health",
      "name": "dq_current_health",
      "queryLines": [
        "SELECT *\n",
        "FROM dq_current_health\n",
        "ORDER BY dataset_name\n"
      ]
    },
    {
      "displayName": "Freshness Status Counts",
      "name": "freshness_status_counts",
      "queryLines": [
        "SELECT freshness_status, COUNT(*) AS dataset_count\n",
        "FROM data_freshness_health\n",
        "GROUP BY freshness_status\n",
        "ORDER BY freshness_status\n"
      ]
    },
    {
      "displayName": "Daily High Security Events",
      "name": "security_daily",
      "queryLines": [
        "SELECT event_date,\n",
        "       SUM(CASE WHEN event_severity IN ('HIGH','CRITICAL') THEN event_count ELSE 0 END) AS high_security_events\n",
        "FROM security_event_daily\n",
        "GROUP BY event_date\n",
        "ORDER BY event_date\n"
      ]
    },
    {
      "displayName": "Fraud Model Current Health",
      "name": "fraud_model_current",
      "queryLines": [
        "SELECT *\n",
        "FROM fraud_model_current_health\n"
      ]
    },
    {
      "displayName": "Agent Evaluation History",
      "name": "agent_evaluation_history",
      "queryLines": [
        "SELECT created_at,\n",
        "       pass_rate,\n",
        "       avg_groundedness_score,\n",
        "       avg_evidence_completeness_score,\n",
        "       safety_rate,\n",
        "       human_review_rate,\n",
        "       overall_pass\n",
        "FROM agent_evaluation_health\n",
        "ORDER BY created_at\n"
      ]
    },
    {
      "displayName": "Daily Databricks Cost",
      "name": "cost_daily",
      "queryLines": [
        "SELECT usage_date, SUM(estimated_list_cost) AS estimated_list_cost\n",
        "FROM databricks_cost_daily\n",
        "GROUP BY usage_date\n",
        "ORDER BY usage_date\n"
      ]
    },
    {
      "displayName": "Databricks Cost by Workload",
      "name": "cost_by_workload",
      "queryLines": [
        "SELECT workload_name, SUM(estimated_list_cost) AS estimated_list_cost\n",
        "FROM databricks_cost_by_workload\n",
        "GROUP BY workload_name\n",
        "HAVING SUM(estimated_list_cost) > 0\n",
        "ORDER BY estimated_list_cost DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "displayName": "Daily Query Performance",
      "name": "query_daily",
      "queryLines": [
        "SELECT *\n",
        "FROM query_performance_daily\n",
        "ORDER BY query_date\n"
      ]
    }
  ],
